-- Kokoro read-aloud: hotkeys and the settings-panel window rule.
--
-- Generated by @ROOT@/linux/install-hyprland.sh.
-- Re-run that instead of editing this file: the paths are baked in at
-- install time, so moving the repo means regenerating it.
--
-- Plain hl.* calls rather than Omarchy's o.* helpers (o.bind is a thin
-- wrapper over hl.bind), so this file needs nothing from Omarchy's Lua setup.

local read_aloud = "'@ROOT@/read_aloud.sh'"

hl.bind("CTRL + ALT + R", hl.dsp.exec_cmd(read_aloud .. " selection"), { description = "Read selection aloud" })
hl.bind("CTRL + ALT + T", hl.dsp.exec_cmd(read_aloud .. " clipboard"), { description = "Read clipboard aloud" })
hl.bind("CTRL + ALT + S", hl.dsp.exec_cmd(read_aloud .. " stop"), { description = "Stop reading aloud" })

-- The settings panel is a Tk window, so its class is the generic "Toplevel";
-- match the title instead. Without this it opens at 0,0 under the bar.
hl.window_rule({ match = { title = "^Kokoro read-aloud - settings$" }, float = true, center = true })
