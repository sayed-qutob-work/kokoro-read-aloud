[Unit]
Description=Kokoro read-aloud TTS server
Documentation=https://github.com/sayed-qutob-work/kokoro-read-aloud
# PipeWire is socket-activated, so this is a hint rather than a hard dependency:
# PortAudio only opens a stream on the first read, long after boot.
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=@ROOT@
# @PYTHON@ is the venv `kokoroctl setup` made, or a hand-made env/ (paths.py)
ExecStart=@PYTHON@ @ROOT@/tts_server.py
# Same contract as start_tts.vbs on Windows: server.log is truncated at each
# start, and is the first thing to read on any failure. It lives in the state
# folder (paths.py). install-systemd.sh and kokoroctl create that folder;
# StateDirectory= cannot, because systemd opens this file first (systemd 261:
# exit 209/STDOUT, AUDIT 2026-10-17).
StandardOutput=truncate:@STATE@/server.log
StandardError=inherit
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
